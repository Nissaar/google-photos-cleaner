<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      INTERNET is the only permission this app requests.

      Deliberately NOT requested:
        - GET_ACCOUNTS / account access   (we never touch on-device Google accounts)
        - READ_MEDIA_IMAGES / storage     (we never read your local photos)
        - ACCESS_NETWORK_STATE            (not needed; avoids extra fingerprinting surface)
      There is no backend: the only host this app ever talks to is Google's own.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      androidx.media3-common declares ACCESS_NETWORK_STATE so its bandwidth meter can
      seed bitrate estimates for adaptive streaming. This app plays one progressive
      file at a time and never adapts, so it gains nothing from it.

      Removing it is safe rather than merely tidy: media3 wraps getActiveNetworkInfo()
      in a catch for SecurityException precisely so it degrades when the permission is
      absent (verified in the 1.5.1 bytecode). Without this, adding video playback
      would have quietly widened the app's permission set.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!--
      Android 11+ hides other installed packages by default, so naming Google Photos
      in an intent silently fails without declaring it here. This is the narrow form:
      one named package, not the QUERY_ALL_PACKAGES permission.
    -->
    <queries>
        <package android:name="com.google.android.apps.photos" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:hasFragileUserData="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhotoCleaner"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.PhotoCleaner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Hands a single cached image to the share sheet. Not exported, and the
          receiving app gets a one-shot read grant for that one file only.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Opt out of WebView metrics collection. -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />
        <!-- Check pages the WebView loads against Google Safe Browsing. -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="true" />
    </application>
</manifest>
